# --- Modo de ejecución -------------------------------------------------------
# api  = usa el backend FastAPI (requiere levantar uvicorn). Es el valor por
#        defecto cuando VITE_API_URL está definido.
# demo = el motor de reglas corre en el navegador, sin backend. Es lo que usa
#        el despliegue de GitHub Pages.
VITE_API_MODE=api

# URL base del backend FastAPI de ParidadCheck (solo se usa en modo api).
VITE_API_URL=http://localhost:8000
